// PostgreSQL: dados críticos e transacionais (usuários, pedidos, pagamento, estoque).
// Catálogo fica no MongoDB e carrinho no Redis.
//
// Convenção de ID de livro: `livro_id` é o volumeId da Google Books API.
// É o _id do documento no MongoDB, a chave do estoque aqui e o campo do carrinho no Redis.
//
// Mudou este arquivo? Rode:
//   docker compose exec api npx prisma migrate dev --name descricao_da_mudanca
// e commite a pasta prisma/migrations junto.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id        Int      @id @default(autoincrement())
  nome      String
  email     String   @unique
  senhaHash String   @map("senha_hash")
  criadoEm  DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)

  pedidos Pedido[]

  @@map("usuario")
}

/// status: ver StatusPedido em src/modules/pedidos/pedido.types.ts
model Pedido {
  id        Int      @id @default(autoincrement())
  usuarioId Int      @map("usuario_id")
  status    String
  total     Decimal  @db.Decimal(10, 2)
  criadoEm  DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)

  usuario   Usuario      @relation(fields: [usuarioId], references: [id])
  itens     ItemPedido[]
  pagamento Pagamento?

  @@index([usuarioId, criadoEm])
  @@map("pedido")
}

/// preco_unitario congela o preço na hora da compra.
/// livro_id aponta para o documento no MongoDB (sem FK: o livro não é tabela daqui).
model ItemPedido {
  id            Int     @id @default(autoincrement())
  pedidoId      Int     @map("pedido_id")
  livroId       String  @map("livro_id")
  precoUnitario Decimal @map("preco_unitario") @db.Decimal(10, 2)
  quantidade    Int // CHECK (quantidade > 0) na migration

  pedido Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  @@index([pedidoId])
  @@map("item_pedido")
}

/// 1:1 com pedido (pedido_id é UNIQUE).
/// metodo/status: ver MetodoPagamento e StatusPagamento em src/modules/pedidos/pedido.types.ts
model Pagamento {
  id       Int     @id @default(autoincrement())
  pedidoId Int     @unique @map("pedido_id")
  metodo   String
  valor    Decimal @db.Decimal(10, 2)
  status   String

  pedido Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  @@map("pagamento")
}

/// Estoque por livro. Fica no relacional para o checkout decrementar
/// dentro da mesma transação que cria o pedido.
model Estoque {
  livroId      String   @id @map("livro_id")
  quantidade   Int // CHECK (quantidade >= 0) na migration
  atualizadoEm DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  @@map("estoque")
}
