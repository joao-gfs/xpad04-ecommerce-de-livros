# Opcional. Tudo tem default no docker-compose.yml; só copie para .env se quiser mudar algo.
#   cp .env.example .env

# Portas expostas no host (mude se alguma já estiver em uso na sua máquina)
POSTGRES_PORT=5432
MONGO_PORT=27017
REDIS_PORT=6379
API_PORT=3000
WEB_PORT=5173

JWT_SECRET=dev-secret-troque-isso

# Sem chave a Google Books API funciona, mas com limite menor por IP.
# Gere uma em https://console.cloud.google.com/apis/credentials se a ingestão começar a dar 429.
GOOGLE_BOOKS_API_KEY=
